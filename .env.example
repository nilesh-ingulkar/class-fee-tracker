# Public Supabase client config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Canonical app URL for auth email links (no trailing slash)
# Production: https://your-app.vercel.app — must match Supabase Auth → Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only invite gate for signup (never use NEXT_PUBLIC_ prefix)
INVITE_CODE=SOMECODE
